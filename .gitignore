# prefer npm over yarn
yarn.lock

# eslint
.eslintcache

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed

# Enviromental
.env

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directory
# Commenting this out is preferred by some people, see
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git-
node_modules

# Users Environment Variables
.lock-wscript

# Webpack related
public/dist/
dist/
dist-ssr/
tmp/
build/

# OSX
.DS_Store

# macOS file sync (iCloud Drive and friends) duplicates files it thinks have
# conflicted, as "main 2.scss", "ThemeToggle 2.tsx" and so on. They are exact
# copies of files that are already tracked, and one has already been staged by
# accident. Nothing in a source tree is legitimately named this way.
* [0-9].*

# Nohup
nohup.out

# Resources
resources/*
